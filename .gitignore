# Local environment and editor noise
.venv/
.opencode/
.DS_Store
*.swp
*.swo
*~

# Python caches
__pycache__/
*.py[cod]

# Downloaded corpus archives
*.xz
*.zip

# Extracted raw corpus sources
corpora/*/resources/*.txt
corpora/*/resources/*/

# Temporary corpus working directories
corpora/*/tmp/
